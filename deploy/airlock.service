[Unit]
Description=Airlock sandboxed coding agent service
After=network-online.target docker.service
Requires=docker.service

[Service]
User=airlock
Group=airlock
WorkingDirectory=/opt/airlock
ExecStart=/usr/bin/python3 -m airlock.service --config /etc/airlock/config.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/airlock

[Install]
WantedBy=multi-user.target
